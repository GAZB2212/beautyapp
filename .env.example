# Copy to apps/book/.env and apps/salon/.env (Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
# Where clients book (shown in the dashboard as the salon's booking link)
EXPO_PUBLIC_BOOKING_ORIGIN=http://localhost:8081
